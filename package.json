{
  "name": "td-emoji-flags",
  "version": "1.0.1",
  "description": "Type-safe country and flag emoji constants for TypeScript, built on td-countries-names.",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "prepublishOnly": "npm run build",
    "test": "jest",
    "lint": "eslint src tests --ext .ts",
    "lint:fix": "eslint src tests --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\""
  },
  "keywords": [
    "emoji",
    "flags",
    "countries",
    "country-flags",
    "typescript",
    "unicode",
    "international"
  ],
  "author": "Jarosław Tusiński",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jarektusinski/td-emoji-flags.git"
  },
  "homepage": "https://github.com/jarektusinski/td-emoji-flags#readme",
  "bugs": {
    "url": "https://github.com/jarektusinski/td-emoji-flags/issues"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "prettier": "^3.2.5",
    "ts-jest": "^29.1.2",
    "tsup": "^8.5.1",
    "typescript": "^5.3.3"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  }
}
